# Masukkan Token Bot Telegram yang didapat dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Opsional: Masukkan Telegram User ID Anda agar bot hanya merespon Anda (bisa dilihat saat /start)
ALLOWED_USER_ID=

# Lokasi file database SQLite (default di dalam folder data)
DATABASE_PATH=data/motor.db
